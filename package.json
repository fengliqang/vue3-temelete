{
  "name": "aa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "npm": ">=10.0.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=9.15.3",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite --mode dev",
    "dev:test": "vite --mode test",
    "dev:demo": "vite --mode demo",
    "dev:prod": "vite --mode prod",
    "build:test": "vue-tsc -b && vite build --mode test",
    "build:demo": "vue-tsc -b && vite build --mode demo",
    "build": "vue-tsc -b && vite build --mode prod",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "axios": "^1.17.0",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "mockjs": "^1.1.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.12",
    "vite-plugin-mock": "^3.0.2",
    "vue-tsc": "^3.2.8"
  }
}
