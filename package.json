{
  "name": "aa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "npm": ">=10.0.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=9.15.3",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite --mode dev",
    "dev:test": "vite --mode test",
    "dev:demo": "vite --mode demo",
    "dev:prod": "vite --mode prod",
    "build:test": "vue-tsc -b && vite build --mode test",
    "build:demo": "vue-tsc -b && vite build --mode demo",
    "build": "vue-tsc -b && vite build --mode prod",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}